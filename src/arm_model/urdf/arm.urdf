<robot name="intern_arm">
<!--
 =====================================================
         LINK 1 : base_link (alas abu gelap + kolom steel)
         Origin = di tanah, tengah alas
         ===================================================== 
-->
<link name="base_link">
<!-- alas lebar -->
<visual>
<geometry>
<cylinder radius="0.10" length="0.03"/>
</geometry>
<origin xyz="0 0 0.015" rpy="0 0 0"/>
<material name="dark_gray">
<color rgba="0.25 0.25 0.28 1"/>
</material>
</visual>
<!-- kolom kecil di atas alas -->
<visual>
<geometry>
<cylinder radius="0.05" length="0.03"/>
</geometry>
<origin xyz="0 0 0.045" rpy="0 0 0"/>
<material name="steel">
<color rgba="0.65 0.68 0.72 1"/>
</material>
</visual>
</link>
<!--
 =====================================================
         LINK 2 : turret biru (yaw) + sendi bahu cyan
         ===================================================== 
-->
<link name="link_2">
<!-- badan turret -->
<visual>
<geometry>
<cylinder radius="0.04" length="0.04"/>
</geometry>
<origin xyz="0 0 0.02" rpy="0 0 0"/>
<material name="blue">
<color rgba="0.15 0.40 0.90 1"/>
</material>
</visual>
<!--
 silinder sendi bahu (sumbu silinder searah sumbu Y) 
-->
<visual>
<geometry>
<cylinder radius="0.03" length="0.07"/>
</geometry>
<origin xyz="0 0 0.04" rpy="1.5708 0 0"/>
<material name="cyan">
<color rgba="0.10 0.75 0.80 1"/>
</material>
</visual>
</link>
<!--
 =====================================================
         LINK 3 : lengan atas oranye (bahu ke siku), 0.25 m
         sendi siku kuning di ujungnya
         ===================================================== 
-->
<link name="link_3">
<visual>
<geometry>
<cylinder radius="0.015" length="0.25"/>
</geometry>
<origin xyz="0 0 0.125" rpy="0 0 0"/>
<material name="orange">
<color rgba="0.95 0.50 0.10 1"/>
</material>
</visual>
<!-- silinder sendi siku -->
<visual>
<geometry>
<cylinder radius="0.025" length="0.05"/>
</geometry>
<origin xyz="0 0 0.25" rpy="1.5708 0 0"/>
<material name="yellow">
<color rgba="0.98 0.82 0.10 1"/>
</material>
</visual>
</link>
<!--
 =====================================================
         LINK 4 : lengan bawah hijau + gripper (telapak ungu, jari merah)
         ===================================================== 
-->
<link name="link_4">
<!-- lengan bawah -->
<visual>
<geometry>
<cylinder radius="0.015" length="0.25"/>
</geometry>
<origin xyz="0 0 0.125" rpy="0 0 0"/>
<material name="green">
<color rgba="0.20 0.70 0.30 1"/>
</material>
</visual>
<!-- telapak gripper -->
<visual>
<geometry>
<box size="0.03 0.06 0.02"/>
</geometry>
<origin xyz="0 0 0.26" rpy="0 0 0"/>
<material name="purple">
<color rgba="0.55 0.25 0.75 1"/>
</material>
</visual>
<!-- jari 1 -->
<visual>
<geometry>
<box size="0.012 0.01 0.05"/>
</geometry>
<origin xyz="0 0.02 0.295" rpy="0 0 0"/>
<material name="red">
<color rgba="0.85 0.15 0.15 1"/>
</material>
</visual>
<!-- jari 2 -->
<visual>
<geometry>
<box size="0.012 0.01 0.05"/>
</geometry>
<origin xyz="0 -0.02 0.295" rpy="0 0 0"/>
<material name="red">
<color rgba="0.85 0.15 0.15 1"/>
</material>
</visual>
</link>
<!--
 =====================================================
         JOINT 1 : yaw (rotasi sumbu Z), servo_1
         ===================================================== 
-->
<joint name="joint_1" type="revolute">
<parent link="base_link"/>
<child link="link_2"/>
<origin xyz="0 0 0.06" rpy="0 0 0"/>
<axis xyz="0 0 1"/>
<limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
</joint>
<!--
 =====================================================
         JOINT 2 : bahu (rotasi sumbu Y), servo_2
         Tinggi bahu dari tanah = 0.06 + 0.04 = 0.10 m
         rpy pitch +0.6 rad (sekitar 34 derajat): lengan atas condong ke depan.
         Posisi joint = 0 berarti pose membungkuk ini.
         ===================================================== 
-->
<joint name="joint_2" type="revolute">
<parent link="link_2"/>
<child link="link_3"/>
<origin xyz="0 0 0.04" rpy="0 0.6 0"/>
<axis xyz="0 1 0"/>
<limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
</joint>
<!--
 =====================================================
         JOINT 3 : siku (rotasi sumbu Y), langsung ke gripper, servo_3
         rpy pitch -1.3 rad (sekitar -74 derajat): siku menekuk jelas,
         lengan bawah miring balik ke belakang (total -0.7 rad dari vertikal).
         ===================================================== 
-->
<joint name="joint_3" type="revolute">
<parent link="link_3"/>
<child link="link_4"/>
<origin xyz="0 0 0.25" rpy="0 -1.3 0"/>
<axis xyz="0 1 0"/>
<limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
</joint>
</robot>